# Copy to `.env` on the host next to docker-compose.yml and fill in real values.
# chmod 600 .env  — these are secrets and must never be committed.

# --- LLM decision layer (DeepSeek) ---
DEEPSEEK_API_KEY=sk-...
LLM_MODEL=deepseek-flash

# --- Alpaca PAPER accounts (three separate paper accounts) ---
ALPACA_DAILY_API_KEY=
ALPACA_DAILY_SECRET_KEY=
ALPACA_WEEKLY_API_KEY=
ALPACA_WEEKLY_SECRET_KEY=
ALPACA_YOLO_API_KEY=
ALPACA_YOLO_SECRET_KEY=

# --- X post feed for the copy follower (x_copy_run.py) ---
# Required for the follower to see the timeline at all. It reads X through the
# xAI Responses API (server-side x_search tool). Without it the bot journals a
# read failure and the watchers alert — it never reports "he posted nothing".
XAI_API_KEY=
# Optional. Only used if the official X API path is switched on in
# config.X_FEED["providers"]: it is exact and returns every post, so it is
# strictly better than the xAI path, but it needs a paid X developer app.
X_BEARER_TOKEN=

# --- Optional fourth Alpaca paper account for the copy follower ---
# Leave empty to run the follower in SHADOW mode: it sizes every trade it would
# take, journals it as an order it did NOT place, and touches no broker. Fill
# these in (any Alpaca paper account) to make it trade for real, no code change.
ALPACA_COPY_API_KEY=
ALPACA_COPY_SECRET_KEY=
ALPACA_COPY_BASE_URL=https://paper-api.alpaca.markets/v2
